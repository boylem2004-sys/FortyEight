# FortyEight environment variables.
# Local dev: copy to apps/web/.env.local and fill in what you need.
# Phase 0 runs with all of these empty (sample data, no accounts).
# Never commit real values. Anything without NEXT_PUBLIC_ stays on the server.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
ANTHROPIC_API_KEY=
AI_MODEL_RANK=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Providers
TICKETMASTER_API_KEY=
# Places API (New) + Geocoding. Server only.
GOOGLE_MAPS_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
FREE_PLANS_PER_MONTH=3
