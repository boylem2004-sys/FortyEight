{
  "name": "fortyeight",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@fortyeight/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @fortyeight/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts"
  },
  "prettier": "@fortyeight/config/prettier",
  "devDependencies": {
    "@fortyeight/config": "workspace:*",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
